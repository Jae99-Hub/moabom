{
  appId: "com.moabom.app",
  productName: "모아봄",
  copyright: "Copyright © 2024",
  protocols: [
    {
      name: "모아봄",
      schemes: ["moabom"]
    }
  ],
  publish: {
    provider: "github",
    owner: "Jae99-Hub",
    repo: "moabom"
  },
  directories: {
    buildResources: "build"
  },
  files: [
    "out/**/*"
  ],
  extraResources: [
    {
      from: "node_modules/sql.js/dist/sql-wasm.wasm",
      to: "sql-wasm.wasm"
    }
  ],
  win: {
    executableName: "moabom",
    target: [
      {
        target: "nsis",
        arch: ["x64"]
      }
    ]
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    shortcutName: "모아봄"
  },
  mac: {
    target: [
      {
        target: "dmg",
        arch: ["x64", "arm64"]
      }
    ]
  }
}
